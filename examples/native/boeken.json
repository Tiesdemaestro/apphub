  "collections": [
    {
      "id": "boeken",
      "title": "Boeken",
      "fields": [
        { "id": "titel", "label": "Titel", "type": "text", "required": true },
        { "id": "auteur", "label": "Auteur", "type": "text", "required": true },
        { "id": "omslag", "label": "Foto van de omslag", "type": "photo" },
        { "id": "leesstatus", "label": "Leesstatus", "type": "choice", "required": true, "options": ["Wil ik lezen", "Aan het lezen", "Uitgelezen", "Gestopt"] },
