  "screens": [
    { "id": "boekenkast", "title": "Boekenkast", "collection": "boeken", "layout": "grid", "titleField": "titel", "subtitleField": "auteur", "imageField": "omslag", "sortField": "titel", "sortDirection": "asc" },
    { "id": "leeslijst", "title": "Leeslijst", "collection": "boeken", "layout": "list", "titleField": "titel", "subtitleField": "leesstatus", "sortField": "leesstatus", "sortDirection": "asc" }
  ],
  "homeScreen": "boekenkast"
