{
  "name": "apphub",
  "version": "1.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "expo start --go",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts web-projects/*/*.test.mjs skills/build-apphub-project/tests/*.test.mjs",
    "check": "npm run test && npm run typecheck && expo install --check",
    "check:project": "node scripts/check-native-project.mjs",
    "configure:release": "node scripts/configure-release.mjs",
    "check:release": "node scripts/release-check.mjs",
    "bundle:ios": "expo export --platform ios",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "start:dev": "expo start --dev-client",
    "check:web": "node scripts/check-web-project.mjs",
    "create:project": "node scripts/create-web-project.mjs",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "test:syntax": "node scripts/check-syntax.mjs",
    "check:store": "node scripts/check-store-readiness.mjs",
    "eas-build-post-install": "node scripts/eas-post-install.mjs",
    "setup": "node scripts/setup-apphub.mjs setup",
    "build:testflight": "node scripts/setup-apphub.mjs testflight",
    "build:simulator": "node scripts/setup-apphub.mjs simulator"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-sqlite": "~58.0.14",
    "react": "19.3.0",
    "react-native": "~0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "expo-document-picker": "~58.0.4",
    "expo-sharing": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "react-dom": "19.3.0"
  }
}
