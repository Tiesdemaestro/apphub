{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "environment": "preview"
    },
    "testflight": {
      "distribution": "store",
      "developmentClient": false,
      "autoIncrement": true,
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
